# Electron's native deps must be hoisted so electron-vite/electron-builder find them
node-linker=hoisted
shamefully-hoist=true
# This repo lives on an exFAT volume, which has no hard-link support. pnpm's default
# "auto" import method (clone/hardlink with fallback) intermittently throws EISDIR
# here instead of falling back cleanly, corrupting node_modules linking. Force plain
# file copies so installs are reliable.
package-import-method=copy
