# Electron's native deps must be hoisted so electron-vite/electron-builder find them
node-linker=hoisted
shamefully-hoist=true
# NOTE: this repo previously lived on an exFAT volume, which has no hard-link support, and
# needed `package-import-method=copy` (pnpm's default "auto" threw EISDIR there instead of
# falling back cleanly). It now lives on NTFS, so auto/hard-linking works — installs went
# from minutes to ~11s and node_modules stopped being ~27k real files. If you ever move this
# repo back onto exFAT (or any volume without hard links), re-add:
#   package-import-method=copy
