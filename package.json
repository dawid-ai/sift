{
  "name": "sift-monorepo",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @sift/desktop dev",
    "build": "pnpm --filter @sift/desktop build",
    "dist": "pnpm --filter @sift/desktop dist",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\""
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ],
    "//overrides": "Transitive advisories with no direct upgrade path: pinned to the patched versions so `pnpm audit --prod` stays clean. Drop an entry once every dependent resolves past it on its own.",
    "overrides": {
      "js-yaml@<5.4.1": ">=5.4.1",
      "nanoid@<3.3.18": ">=3.3.18",
      "postcss@<8.5.23": ">=8.5.23"
    }
  }
}
